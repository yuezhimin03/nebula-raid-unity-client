* text=auto

# Hot-update manifests hash exact package bytes, so checkout must not rewrite them.
*.lua  text eol=lf
*.json text eol=lf

# Keep source and CI files stable across Windows and Linux runners.
*.cs     text eol=lf
*.csproj text eol=lf
*.props  text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf
*.sln    text eol=crlf
